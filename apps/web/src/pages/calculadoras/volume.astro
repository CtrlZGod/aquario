---
import Base from '../../layouts/Base.astro';
import VolumeCalculator from '../../components/VolumeCalculator';
---

<Base
  title="Calculadora de volume do aquário"
  description="Calcula o volume bruto e o volume real de água de um aquário retangular."
>
  <h1 class="text-2xl font-semibold">Calculadora de volume</h1>
  <p class="mt-2 text-slate-600">Aquário retangular. Medidas exteriores em centímetros.</p>
  <VolumeCalculator client:load />
</Base>
